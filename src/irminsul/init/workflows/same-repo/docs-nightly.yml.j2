name: docs-nightly

# Configured deterministic warnings run nightly, catching drift that the
# blocking hard profile does not gate on (orphans, staleness, mtime drift).

on:
  schedule:
    - cron: "23 6 * * *"   # daily at 06:23 UTC
  workflow_dispatch:

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: {{ github_user }}/irminsul@v0.1.0
        with:
          profile: configured
