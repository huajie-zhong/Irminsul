name: docs-pr

# Siblings layout: this docs repo and the code repo are two separate git
# repositories that live side by side under one parent directory, so
# `source_roots` in irminsul.toml point out through `../`. CI has to rebuild
# that shape before it can run the gate: every checkout gets an explicit
# `path:` under a common parent, and the Action's `path` input points irminsul at
# the docs checkout.
#
# No `paths:` filter: a required check whose workflow a filter skipped stays Pending,
# so a pull request touching only a file the filter missed could never merge.

on:
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          path: {{ docs_checkout_path }}
          fetch-depth: 0   # mtime drift needs full history
{% if code_repo_spec %}
      - uses: actions/checkout@v4
        with:
          repository: {{ code_repo_spec }}
          path: {{ code_checkout_path }}
          fetch-depth: 0   # mtime drift reads the code repo's own history
          # A private code repo also needs a credential here, e.g.
          # token: {% raw %}${{ secrets.CODE_REPO_TOKEN }}{% endraw %}
{% else %}
      # TODO: the code repo was configured as a local path, so its GitHub
      # coordinate is unknown. Fill in `repository:` below.
      - uses: actions/checkout@v4
        with:
          repository: OWNER/CODE-REPO
          path: {{ code_checkout_path }}
          fetch-depth: 0
{% endif %}
      - uses: {{ action_repository }}@{{ action_ref }}
        with:
          path: {{ docs_checkout_path }}
          diff: {% raw %}origin/${{ github.base_ref }}{% endraw %}
